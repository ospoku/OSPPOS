@using DMX.ViewComponents
@using OSPPOS.ViewComponents
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <style>
        .tab-button.active {
            background-color: #1f2937 !important;
            border-color: #60a5fa !important;
            color: #60a5fa !important;
            box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.2);
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
    </style>

<ul class="nav nav-tabs nav-tabs-dim" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="organization-tab" data-bs-toggle="tab" data-bs-target="#organization" type="button" role="tab">
            <i class="bi bi-building"></i>Organization
        </button>

    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#units" type="button" role="tab">
            <i class="bi bi-boxes"></i>Units <span class="badge">12</span>
        </button>
     
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="analytics-tab" data-bs-toggle="tab" data-bs-target="#analytics" type="button" role="tab">
            <i class="bi bi-grid"></i>Categories
        </button>
     
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab">
            <i class="bi bi-gear"></i>Settings
        </button>
     
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="activity-tab" data-bs-toggle="tab" data-bs-target="#activity" type="button" role="tab">
            <i class="bi bi-clock-history"></i>Activity
        </button>
     
    </li>
   
        <li class="nav-item" role="presentation">
        <button class="nav-link" id="organization-tab" data-bs-toggle="tab" data-bs-target="#customerSettings" type="button" role="tab">
            <i class="bi bi-building"></i>Customer Settings
        </button>

    </li>
           <li class="nav-item" role="presentation">
        <button class="nav-link" id="organization-tab" data-bs-toggle="tab" data-bs-target="#finance" type="button" role="tab">
            <i class="bi bi-coin"></i>Finance
        </button>

    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="organization-tab" data-bs-toggle="tab" data-bs-target="backup" type="button" role="tab">
            <i class="bi bi-upload"></i>Backup
        </button>

    </li>
</ul>
<div class="tab-content">
     <div class="tab-pane fade show active" id="organization">
        @await Component.InvokeAsync(nameof(Organization))
    </div>
    <div class="tab-pane fade" id="units">
         @await Component.InvokeAsync(nameof(ViewUnits))
    </div>  <div class="tab-pane fade" id="categories">
        @await Component.InvokeAsync(nameof(ViewCategories))
    </div>
    <div class="tab-pane fade" id="activities">
        @await Component.InvokeAsync(nameof(ViewActivities))
    </div>
    <div class="tab-pane fade" id="customerSettings">
        @await Component.InvokeAsync(nameof(ViewCustomerSettings))
    </div>
    <div class="tab-pane fade" id="finance">
        @await Component.InvokeAsync(nameof(Finance))
    </div>  <div class="tab-pane fade" id="backup">
        @await Component.InvokeAsync(nameof(Backup))
    </div>
    <!-- ... other panes ... -->
</div>
@section scripts{
    <script>
          document.addEventListener("DOMContentLoaded", (function() {
              $('#unitsTable').DataTable({
                pageLength: 5,
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
               order: [[4, 'desc']],
              columnDefs: [
                 { orderable: false, targets: 5 }
              ],
              language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ products",
                 info: "Showing _START_ to _END_ of _TOTAL_ products",
                 infoEmpty: "No product found",
                 infoFiltered: "(filtered from _MAX_ total products)",
                  zeroRecords: "No product found"
                },
                 dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                   '<"row"<"col-sm-12"tr>>' +
                     '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
              })}));
    </script>
}