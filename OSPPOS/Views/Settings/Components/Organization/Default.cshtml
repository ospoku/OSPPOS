<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle select elements for floating labels
        document.querySelectorAll('.did-floating-select').forEach(select => {
            // Check initial state
            if (select.value && select.value !== '') {
                select.classList.add('has-value');
            }

            // Update on change
            select.addEventListener('change', function() {
                if (this.value && this.value !== '') {
                    this.classList.add('has-value');
                } else {
                    this.classList.remove('has-value');
                }
            });
        });

        //Form validation
        const form = document.getElementById('organizationForm');

        form.addEventListener('submit', function(e) {
            const orgName = document.getElementById('orgName');
            const orgEmail = document.getElementById('orgEmail');
            let isValid = true;

            // Validate organization name
            if (orgName.value.trim().length < 2) {
                orgName.style.borderColor = '#dc3545';
                orgName.focus();
                isValid = false;
            } else {
                orgName.style.borderColor = '#ced4da';
            }

            // Validate email
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailPattern.test(orgEmail.value)) {
                orgEmail.style.borderColor = '#dc3545';
                if (isValid) orgEmail.focus();
                isValid = false;
            } else {
                orgEmail.style.borderColor = '#ced4da';
            }

            if (!isValid) {
                e.preventDefault();
                // Show alert
                alert('Please fix the highlighted fields before submitting.');
            }
        });

        // Remove error styling on input
        document.querySelectorAll('.did-floating-input, .did-floating-select').forEach(input => {
            input.addEventListener('input', function() {
                this.style.borderColor = '#ced4da';
            });
        });
    });
</script>  






       