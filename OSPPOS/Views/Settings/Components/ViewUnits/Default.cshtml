

@using System.Web
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.AspNetCore.Identity
@using OSPPOS.Models
@using OSPPOS.ViewComponents
@using OSPPOS.ViewModels
@inject UserManager<AppUser> usm;

@model IEnumerable<OSPPOS.ViewModels.ViewUnitsVM>;
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtectionProvider

@{
    // Optional: create protector in view (same purpose string)
    var protector = DataProtectionProvider.CreateProtector("IdProtector");
  
}
<div class="tab-content tab-content-dim" id="divCustomersContent">
    <!-- TAB 1: USERS -->
    <div class="tab-pane fade show active tab-pane-dim" id="units" role="tabpanel">
        <div class="tab-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-semibold mb-0"><i class="bi bi-people me-2"></i>Units</h6>
                <button class="btn btn-primary btn-sm" id="openFormBtn2" onclick="document.getElementById('AddCustomerDialog').showModal()">
                    <i class="bi bi-plus-circle me-1"></i>Add Unit
                </button>
            </div>
            <!-- DATATABLES -->
            <div class="table-container">
                <table id="unitsTable" class="table darkTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Tax Number</th>
                            <th>IsActive</th>
                            <th>Allow Credit</th>
                            <th>Credit Limit</th>
                            <th>Sales Order</th>
                            <th>Payments</th>
                            <th>Total Debt</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                                     @foreach (var customer in Model)
                {
                        <tr>
                            
                                <td class="ellipsed-text">@customer.Name</td>
                            <td class="ellipsed-text"> @customer.Phone</td>

                            <td class="ellipsed-text">@customer.Email</td>
                            <td class="ellipsed-text">
                                @customer.Address
                            </td>
                            <td>@customer.Phone</td>
                            <td ><span class="status-badge status-active">@customer.IsActive</span></td>
                            <td>@customer.Email</td>
                                <td>@customer.Address</td>
                                <td>@customer.Address</td>
                                <td>@customer.Address</td>
                                <td>@customer.Address</td>
                 
                                <td>
                                <div class="dropdown action-dropdown">
                                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Select Action
                                    </button>
                                    <ul class="dropdown-menu">
                                            @if (customer.CanEdit)
                                            {

                                                <li onclick="openDialogFromData(this)" data-url="EditCustomer" data-user-id="@protector.Protect(customer.PublicId.ToString())" data-dialog-id="EditCustomerDialog" class="dropdown-item-custom"><i style="width:15px; height:15px" class=" fa fa-edit mr-3 text-warning"></i>Edit</li>
                                            }
                                            @if (customer.CanPrint)
                                            {

                                                <li type="button" class="dropdown-item-custom" onclick="printcustomerIframe('@protector.Protect(customer.PublicId.ToString())')">
                                                    <i style="width:15px; height:15px" class="fa fa-print mr-3 text-primary"></i>Print
                                                </li>
                                            }
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-pencil text-primary"></i> Edit</a></li>
                                        <li><a class="dropdown-item" href="#"><i class="bi bi-eye text-info"></i> View</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-trash"></i> Delete</a></li>
                                    </ul>
                                    </div>
                                </td>
                        </tr>
                        }
                  
                           
                 
               
                    </tbody>
                </table>
            </div>
        </div>
    </div>

  </div>
@* 
    @await Component.InvokeAsync(nameof(AddCustomer)) *@

    <dialog id="EditCustomerDialog">
        <div id="EditCustomerDialogContent"></div>
    </dialog>

<iframe id="printFrame" style="display:none;"></iframe>
@section scripts{
<script type="text/javascript">
    function printcustomerIframe(customerId) {
        const printFrame = document.getElementById('printFrame');
        printFrame.src = `/customer/Printcustomer?Id=${customerId}`;
        printFrame.onload = function () {
            printFrame.contentWindow.focus();
            printFrame.contentWindow.print();
        };
    }



