<style>
    /* ========================================
           COMPONENT STYLES (in-text for Organization form)
           ======================================== */

    /* ----- CARDS ----- */
    .card-custom {
        border: 1px solid #2d323a;
        border-radius: 10px;
        background: #1e2229;
        transition: all 0.3s ease;
    }

        .card-custom:hover {
            border-color: #3d424a;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
        }

    .card-header-custom {
        padding: 0.75rem 1rem;
        background: transparent;
        border-bottom: 1px solid #2d323a;
    }

        .card-header-custom h6 {
            font-weight: 600;
            color: #e4e6eb;
            margin: 0;
            font-size: 0.9rem;
        }

            .card-header-custom h6 i {
                color: #667eea;
                margin-right: 8px;
            }

    .card-body-custom {
        padding: 1rem;
    }

    .card-custom::-webkit-scrollbar {
        width: 6px;
    }

    .card-custom::-webkit-scrollbar-track {
        background: #1a1d23;
        border-radius: 10px;
    }

    .card-custom::-webkit-scrollbar-thumb {
        background: #3d424a;
        border-radius: 10px;
    }

        .card-custom::-webkit-scrollbar-thumb:hover {
            background: #4d525a;
        }

    /* ----- FLOATING LABELS ----- */
    .did-floating-label-content {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .did-floating-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1.5px solid #2d323a;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background: #1a1d23;
        color: #e4e6eb;
    }

        .did-floating-input:focus {
            border-color: #667eea;
            outline: 0;
            background: #1e2229;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }

            .did-floating-input:focus ~ .did-floating-label {
                top: -10px;
                font-size: 13px;
                background: #1e2229;
                color: #667eea;
            }

        .did-floating-input::placeholder {
            color: #6c757d;
        }

        .did-floating-input:not(:placeholder-shown) ~ .did-floating-label {
            top: -10px;
            font-size: 13px;
            background: #1a1d23;
            color: #8c929a;
        }

    .did-floating-label {
        position: absolute;
        top: 10px;
        left: 12px;
        background: #1a1d23;
        padding: 0 6px;
        font-size: 0.8rem;
        color: #8c929a;
        pointer-events: none;
        transition: all 0.2s ease;
        font-weight: 500;
        -moz-transition: 0.2s ease all;
        -webkit-transition: 0.2s ease all;
    }

    /* Extra polish for the address heading + buttons area */
    .card-body-custom h5 {
        color: #e4e6eb;
        font-size: 1rem;
    }

        .card-body-custom h5 i {
            color: #667eea;
            margin-right: 6px;
        }

    .card-body-custom hr {
        border-color: #2d323a;
        opacity: 1;
    }

    .card-body-custom .border-top {
        border-color: #2d323a !important;
    }
</style>



