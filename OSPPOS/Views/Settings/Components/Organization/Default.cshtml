
@using OSPPOS.ViewComponents

<div class="d-flex justify-content-center">
    <div class="card-custom col-md-8 col-lg-6">
        <div class="card-header-custom">
            <h6 class="mb-0"><i class="bi bi-building"></i> Organization Details</h6>
        </div>
        <div class="card-body-custom p-4">
            <form id="organizationForm" method="post" action="@Url.Action("UpdateOrganization", "Home")">
                @Html.AntiForgeryToken()

                <!-- Basic Information -->
                <div class="did-floating-label-content">
                    <input type="text" class="did-floating-input" id="orgName" name="OrganizationName"
                           placeholder=" " required value="@Model?.OrganizationName" />
                    <label for="orgName" class="did-floating-label">Organization Name <span class="text-danger">*</span></label>
                </div>

                <div class="did-floating-label-content">
                    <input type="email" class="did-floating-input" id="orgEmail" name="Email"
                           placeholder=" " required value="@Model?.Email" />
                    <label for="orgEmail" class="did-floating-label">Email Address <span class="text-danger">*</span></label>
                </div>

                <div class="did-floating-label-content">
                    <input type="tel" class="did-floating-input" id="orgPhone" name="Phone"
                           placeholder=" " value="@Model?.Phone" />
                    <label for="orgPhone" class="did-floating-label">Phone Number</label>
                </div>

                <div class="did-floating-label-content">
                    <input type="url" class="did-floating-input" id="orgWebsite" name="Website"
                           placeholder=" " value="@Model?.Website" />
                    <label for="orgWebsite" class="did-floating-label">Website</label>
                </div>

                <!-- Address Information -->
                <hr class="my-4" />
                <h5 class="mb-3"><i class="bi bi-geo-alt"></i> Address Information</h5>

                <div class="did-floating-label-content">
                    <input type="text" class="did-floating-input" id="orgAddress" name="Address"
                           placeholder=" " value="@Model?.Address" />
                    <label for="orgAddress" class="did-floating-label">Street Address</label>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="did-floating-label-content">
                            <input type="text" class="did-floating-input" id="orgCity" name="City"
                                   placeholder=" " value="@Model?.City" />
                            <label for="orgCity" class="did-floating-label">City</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="did-floating-label-content">
                            <input type="text" class="did-floating-input" id="orgState" name="State"
                                   placeholder=" " value="@Model?.State" />
                            <label for="orgState" class="did-floating-label">State/Province</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="did-floating-label-content">
                            <input type="text" class="did-floating-input" id="orgZip" name="ZipCode"
                                   placeholder=" " value="@Model?.ZipCode" />
                            <label for="orgZip" class="did-floating-label">ZIP/Postal Code</label>
                        </div>
                    </div>
                </div>

             

                <!-- Form Actions -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-secondary" onclick="window.history.back()">
                        <i class="bi bi-x-circle"></i> Cancel
                    </button>
                    <button type="reset" class="btn btn-warning">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Organization
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Floating Label Styles -->


<!-- Script for select floating label support -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle select elements for floating labels
        document.querySelectorAll('.did-floating-select').forEach(select => {
            // Check initial state
            if (select.value && select.value !== '') {
                select.classList.add('has-value');
            }

            // Update on change
            select.addEventListener('change', function() {
                if (this.value && this.value !== '') {
                    this.classList.add('has-value');
                } else {
                    this.classList.remove('has-value');
                }
            });
        });

        // Form validation
        const form = document.getElementById('organizationForm');

        form.addEventListener('submit', function(e) {
            const orgName = document.getElementById('orgName');
            const orgEmail = document.getElementById('orgEmail');
            let isValid = true;

            // Validate organization name
            if (orgName.value.trim().length < 2) {
                orgName.style.borderColor = '#dc3545';
                orgName.focus();
                isValid = false;
            } else {
                orgName.style.borderColor = '#ced4da';
            }

            // Validate email
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailPattern.test(orgEmail.value)) {
                orgEmail.style.borderColor = '#dc3545';
                if (isValid) orgEmail.focus();
                isValid = false;
            } else {
                orgEmail.style.borderColor = '#ced4da';
            }

            if (!isValid) {
                e.preventDefault();
                // Show alert
                alert('Please fix the highlighted fields before submitting.');
            }
        });

        // Remove error styling on input
        document.querySelectorAll('.did-floating-input, .did-floating-select').forEach(input => {
            input.addEventListener('input', function() {
                this.style.borderColor = '#ced4da';
            });
        });
    });
</script>



<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Form validation
        const form = document.getElementById('organizationForm');

        form.addEventListener('submit', function(e) {
            const orgName = document.getElementById('orgName');
            const orgEmail = document.getElementById('orgEmail');
            let isValid = true;

            // Validate organization name
            if (orgName.value.trim().length < 2) {
                alert('Organization name must be at least 2 characters long.');
                orgName.classList.add('is-invalid');
                isValid = false;
            } else {
                orgName.classList.remove('is-invalid');
            }

            // Validate email
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailPattern.test(orgEmail.value)) {
                alert('Please enter a valid email address.');
                orgEmail.classList.add('is-invalid');
                isValid = false;
            } else {
                orgEmail.classList.remove('is-invalid');
            }

            if (!isValid) {
                e.preventDefault();
            }
        });

        // Remove invalid class on input
        document.querySelectorAll('.form-control, .form-select').forEach(input => {
            input.addEventListener('input', function() {
                this.classList.remove('is-invalid');
            });
        });
    });
</script>



