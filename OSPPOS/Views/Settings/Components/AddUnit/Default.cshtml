
@model OSPPOS.ViewModels.AddUnitVM;

<div class="slide-panel" style="position: fixed;
    top: 0;
    right: -300px; /* Hide panel off-screen initially */
    width: 300px;
    height: 100%;
    background: #f8f9fa;
    box-shadow: -2px 0 5px rgba(0, 0, 0, 0.3);
    transition: right 0.3s ease;
    z-index: 1000;
    padding: 20px;" data-panel="unitPanel" id="unitPanel">
    <div class="card">
        <div class="card-header">
                <h6 class="d-inline">Add Travel Type</h6>
            
            <button id="btnCloseTravel" type="button" name="nCloseTravelPanel" data-close="travelPanel" class="d-line btn btn-sm btn-outline-danger fa-pull-right">X</button>

        </div>
             @using (Html.BeginForm("AddTravelType", "Settings", FormMethod.Post))
            {
            <div class="card-body">
                <div class="input-group">
                    <div class="input-group-text">
                        <i class="fas fa-code"></i>
                    </div>  <div class="did-floating-label-content">
                        <input type="text" asp-for="@Model.Name" id="txtAddTravelName" placeholder=""   required class=" did-floating-input">
                        <label class="did-floating-label"  for="txtAddTravelName">Name</label>
                    
                    </div>
                    </div>
                <div class="input-group">
                    <div class="input-group-text">
                        <i class="fas fa-code"></i>
                    </div>  <div class="did-floating-label-content">
                        <input class="did-floating-input" type="text" asp-for="@Model.Code"id="txtAddTravelCode" placeholder=""  required>
                    <label class="did-floating-label" for="txtAddTravelCode">Code</label>
                    </div>
                    </div>
                <div class="input-group">
                    <div class="input-group-text">
                        <i class="fas fa-code"></i>
                    </div>  <div class="did-floating-label-content">
                        <input class="did-floating-input" type="text" asp-for="@Model.Description"  id="txtAddTravelDescription"  placeholder="" required>
                    <label class="did-floating-label" for="txtAddTravelDescription">Description</label>
                    </div>
                   </div>
                    </div>

                    <div class="card-footer"><button class="btn btn-block btn-primary">Save</button></div>
                }
            </div>
    </div>


